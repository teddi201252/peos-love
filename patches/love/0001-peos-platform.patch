diff -ruN love-11.5.orig/src/love.cpp love-11.5/src/love.cpp
--- a/src/love.cpp	2026-11-17 13:12:03
+++ b/src/love.cpp	2026-11-17 13:32:38
@@ -18,6 +18,7 @@
  * 3. This notice may not be removed or altered from any source distribution.
  **/
 
+#include <cstring>
 #include "common/version.h"
 #include "common/runtime.h"
 #include "modules/love/love.h"
@@ -145,8 +146,47 @@
 	DONE_RESTART,
 };
 
+#ifdef LOVE_PEOS
+#include <sys/stat.h>
+#include <string>
+#include <vector>
+#endif
+
 static DoneAction runlove(int argc, char **argv, int &retval)
 {
+#ifdef LOVE_PEOS
+	// PeOS (an app.ini's args): "--first A B ...": the first of the games
+	// that exists, looked for again at every restart (balatro.app: the game
+	// once its setup has copied it in place and restarted). A path not
+	// starting with '/' is the bundle's: beside app.bin (argv[0]), wherever
+	// the bundle is (/system/apps or /apps).
+	static std::vector<std::string> peos_paths;
+	std::vector<char *> peos_argv;
+	if (argc > 2 && strcmp(argv[1], "--first") == 0)
+	{
+		std::string dir = argv[0];
+		size_t slash = dir.rfind('/');
+		dir = slash == std::string::npos ? std::string(".") : dir.substr(0, slash);
+		peos_paths.clear();
+		for (int i = 2; i < argc; i++)
+			peos_paths.push_back(argv[i][0] == '/' ? std::string(argv[i]) : dir + "/" + argv[i]);
+		size_t pick = peos_paths.size() - 1;
+		for (size_t i = 0; i < peos_paths.size(); i++)
+		{
+			struct stat st;
+			if (stat(peos_paths[i].c_str(), &st) == 0)
+			{
+				pick = i;
+				break;
+			}
+		}
+		peos_argv.push_back(argv[0]);
+		peos_argv.push_back((char *) peos_paths[pick].c_str());
+		peos_argv.push_back(nullptr);
+		argc = 2;
+		argv = peos_argv.data();
+	}
+#endif
 	// Oh, you just want the version? Okay!
 	if (argc > 1 && strcmp(argv[1], "--version") == 0)
 	{
